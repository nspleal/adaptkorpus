# ============================================================================
# App Evokorpus — variáveis de ambiente (MODELO)
# ----------------------------------------------------------------------------
# Copie para `.env.local` e preencha. NUNCA commite `.env.local` (está no .gitignore).
# Segredos de verdade vivem só no painel da Vercel (Environment Variables) e localmente.
# ============================================================================

# --- Supabase (público — pode ir ao browser; protegido por RLS) ---------------
# A anon key é PÚBLICA por design: toda a proteção vem das políticas RLS no banco.
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-anon-key-publica"

# --- Supabase (SEGREDO — somente servidor; bypassa RLS) -----------------------
# ⚠️ NUNCA prefixe com NEXT_PUBLIC_. NUNCA exponha ao browser. Uso restrito a
# rotas de servidor confiáveis (ex.: webhook da Kiwify). Vaza = acesso total ao banco.
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-SECRETA"

# --- Kiwify (webhook de assinatura → Supabase) --------------------------------
# Segredo usado para validar a assinatura HMAC do webhook (anti-spoofing).
KIWIFY_WEBHOOK_SECRET="segredo-do-webhook-kiwify"

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
